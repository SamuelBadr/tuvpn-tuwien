#!/bin/bash
set -euo pipefail
PATH='/usr/bin:/bin:/usr/sbin:/sbin'
export PATH

readonly VPNCTL='/usr/local/sbin/tuwien-vpnctl'
readonly SUDO='/usr/bin/sudo'
readonly PASS_SERVICE='TUWien VPN Password'
readonly TOTP_SERVICE='TUWien VPN TOTP Seed'

usage() {
  cat <<'EOF'
Usage: tuvpn COMMAND

Commands:
  connect            Connect using 1_TU_getunnelt (TU traffic only)
  disconnect         Disconnect cleanly and restore DNS
  status             Print up, degraded, or down
  doctor             Check runtime, Keychain entries, server, and secret handling
  logs               Show recent OpenConnect log output
  help               Show this help
EOF
}

# The TU Wien account is whatever account the Keychain password item is filed
# under, so there is nothing else to configure.
account() {
  security find-generic-password -s "$PASS_SERVICE" 2>/dev/null \
    | sed -n 's/^ *"acct"<blob>="\(.*\)"$/\1/p'
}

run_ctl() {
  [[ -x "$VPNCTL" ]] || { echo "TUvpn controller is not installed: $VPNCTL" >&2; exit 1; }
  "$SUDO" "$VPNCTL" "$@"
}

# Connect needs secrets from the login Keychain, which only the logged-in user
# can read, so this wrapper reads account, password and TOTP seed unprivileged,
# then feeds them to the privileged controller on stdin. They never appear in
# argv, the environment, or on disk.
connect() {
  local acct pass seed
  acct=$(account)
  [[ -n "$acct" ]] || { echo "TUvpn: no Keychain item '$PASS_SERVICE' (run: tuvpn doctor)" >&2; exit 1; }
  pass=$(security find-generic-password -w -a "$acct" -s "$PASS_SERVICE" 2>/dev/null) \
    || { echo "TUvpn: password not found in Keychain for $acct (run: tuvpn doctor)" >&2; exit 1; }
  seed=$(security find-generic-password -w -a "$acct" -s "$TOTP_SERVICE" 2>/dev/null) \
    || { echo "TUvpn: TOTP seed not found in Keychain for $acct (run: tuvpn doctor)" >&2; exit 1; }
  printf '%s\n%s\n%s\n' "$acct" "$pass" "$seed" | run_ctl connect
}

doctor() {
  local acct
  run_ctl doctor || true
  acct=$(account)
  if [[ -z "$acct" ]]; then
    echo 'keychain=missing; add your items with:'
    echo "  security add-generic-password -a you@tuwien.ac.at -s '$PASS_SERVICE' -w"
    echo "  security add-generic-password -a you@tuwien.ac.at -s '$TOTP_SERVICE' -w"
    return 1
  fi
  echo "account=$acct"
  echo "totp_keychain=$(security find-generic-password -a "$acct" -s "$TOTP_SERVICE" >/dev/null 2>&1 && echo present || echo missing)"
}

case "${1:-help}" in
  connect) connect ;;
  disconnect|status|logs) run_ctl "$1" ;;
  doctor) doctor ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
