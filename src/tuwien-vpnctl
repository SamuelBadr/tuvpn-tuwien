#!/bin/bash
set -euo pipefail
PATH='/usr/bin:/bin:/usr/sbin:/sbin'
export PATH

# TU Wien OpenConnect control helper for macOS.
# This file is root-owned and is the only privileged control plane used by the
# user-facing CLI. Keep all executable paths fixed and root-owned.

readonly AUTHGROUP='1_TU_getunnelt'
readonly HOST='vpn.tuwien.ac.at'
readonly OPENCONNECT='/usr/local/libexec/tuwien-openconnect-9.21/bin/openconnect'
readonly VPNC_SCRIPT='/usr/local/libexec/tuwien-openconnect-9.21/scripts/vpnc-script'

readonly PIDFILE='/var/run/openconnect-tuwien.pid'
readonly LOCK_DIR='/var/run/tuwien-vpnctl.lock'
readonly LOG_DIR='/var/run/tuwien-vpn'
readonly LOG_FILE="$LOG_DIR/openconnect.log"

readonly VPN_DNS_IP='128.130.4.3'
readonly VPN_DOMAIN='tuwien.ac.at'
readonly VPN_GATEWAY_IPV4='128.131.240.4'
readonly VPN_GATEWAY_IPV6='2001:629:8010:795::4'

readonly CONNECT_TIMEOUT=30
readonly DISCONNECT_TIMEOUT=12
readonly LOCK_TIMEOUT=30
readonly STALE_LOCK_SECONDS=600
readonly RESOLVE_TIMEOUT=3
readonly RECONNECT_TIMEOUT=86400
readonly DPD_INTERVAL=30

readonly PUBLIC_DNS_SERVERS='192.168.0.1 1.1.1.1 8.8.8.8'

# Credentials for one connect run, set once from stdin by
# read_credentials() and reused by every openconnect_cmd call (including the
# internal retry). Shell variables only - never argv, environment, or files.
USER_EMAIL=''
TUW_PASS=''
TUW_SEED=''

log() { printf '%s\n' "$*" >&2; }
usage() { echo "usage: $0 {status|connect|disconnect|doctor|logs}" >&2; }

require_root() {
  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    echo "This helper must run as root." >&2
    exit 1
  fi
}

with_lock() {
  local elapsed=0 lock_mtime now lock_pid=""

  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    lock_pid=""
    [[ -r "$LOCK_DIR/pid" ]] && lock_pid=$(tr -d '[:space:]' < "$LOCK_DIR/pid" 2>/dev/null || true)

    # Only break the lock when its holder is provably gone: the pid it names is
    # dead, or no pid was ever written and the lock is ancient. A lock whose pid
    # is still alive is never removed, however old the directory mtime looks.
    local stale="" current_pid
    if [[ -n "$lock_pid" ]] && ! ps -p "$lock_pid" >/dev/null 2>&1; then
      stale=1
    elif [[ -z "$lock_pid" ]]; then
      lock_mtime=$(stat -f %m "$LOCK_DIR" 2>/dev/null || echo 0)
      now=$(date +%s)
      (( now - lock_mtime > STALE_LOCK_SECONDS )) && stale=1
    fi

    if [[ -n "$stale" ]]; then
      # CAS: re-read the pid file and only remove the lock if it still names the
      # same dead holder, so a freshly acquired lock is never clobbered.
      current_pid=$(tr -d '[:space:]' < "$LOCK_DIR/pid" 2>/dev/null || true)
      if [[ "$current_pid" == "$lock_pid" ]]; then
        log "Removing stale lock $LOCK_DIR${lock_pid:+ from pid $lock_pid}"
        rm -rf "$LOCK_DIR" 2>/dev/null || true
        continue
      fi
    fi

    if (( elapsed >= LOCK_TIMEOUT )); then
      log "Another tuwien-vpnctl operation is active${lock_pid:+ (pid $lock_pid)}; timed out waiting for lock."
      return 1
    fi

    sleep 1
    elapsed=$((elapsed + 1))
  done

  printf '%s\n' "$$" > "$LOCK_DIR/pid" 2>/dev/null || true
  trap 'rm -rf "$LOCK_DIR" >/dev/null 2>&1 || true' EXIT
  # INT/TERM must terminate this process so EXIT removes the lock.
  trap 'exit 130' INT
  trap 'exit 143' TERM
  "$@"
}

pid_from_file() { [[ -r "$PIDFILE" ]] && tr -d '[:space:]' < "$PIDFILE"; }
pid_is_alive() {
  local pid=${1:-}
  [[ "$pid" =~ ^[0-9]+$ ]] && ps -p "$pid" >/dev/null 2>&1
}
pid_is_openconnect() {
  local pid=${1:-} command
  pid_is_alive "$pid" || return 1
  command=$(ps -p "$pid" -o command= 2>/dev/null || true)
  [[ "$command" == "$OPENCONNECT "* || "$command" == "$OPENCONNECT" ]] || return 1
  [[ "$command" == *"$HOST"* ]]
}

find_vpn_iface() { route -n get "$VPN_DNS_IP" 2>/dev/null | awk -F': ' '/interface:/{print $2; exit}'; }
vpn_healthcheck() {
  /usr/bin/dig +time=2 +tries=1 +short @"$VPN_DNS_IP" "$VPN_DOMAIN" A 2>/dev/null \
    | /usr/bin/grep -Eq '^[0-9]+(\.[0-9]+){3}$'
}

macos_resolves_vpn_host() {
  # OpenConnect uses macOS getaddrinfo(). Bound it inside the resolver process
  # so a stale supplemental resolver cannot hang status and no helper
  # process is orphaned when the timeout expires.
  /usr/bin/python3 - "$HOST" "$RESOLVE_TIMEOUT" >/dev/null 2>&1 <<'PY'
import signal
import socket
import sys


def timed_out(_signum, _frame):
    raise TimeoutError


signal.signal(signal.SIGALRM, timed_out)
signal.alarm(int(sys.argv[2]))
try:
    socket.getaddrinfo(sys.argv[1], 443)
except (OSError, TimeoutError):
    raise SystemExit(1)
finally:
    signal.alarm(0)
PY
}

system_resolves_vpn_host() { macos_resolves_vpn_host; }

resolve_vpn_host_public_ipv4() {
  local server ip
  for server in $PUBLIC_DNS_SERVERS; do
    ip=$(dig +time=1 +tries=1 +short @"$server" "$HOST" A 2>/dev/null \
      | awk '/^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/{print; exit}') || true
    if [[ "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      printf '%s\n' "$ip"
      return 0
    fi
  done
  return 1
}

vpn_dns_state_keys() {
  printf 'list State:/Network/Service/.*/DNS\nquit\n' | scutil 2>/dev/null \
    | awk -F'= ' '/State:\/Network\/Service\/utun[0-9]+\/DNS/{print $2}'
}

scutil_key_mentions_vpn_domain() { printf 'show %s\nquit\n' "$1" | scutil 2>/dev/null | grep -q "$VPN_DOMAIN"; }
remove_scutil_key() { printf 'remove %s\nquit\n' "$1" | scutil >/dev/null 2>&1 || true; }

clear_vpn_dns_state() {
  # stale: remove VPN DNS only for dead utun interfaces; all: remove all TU Wien utun DNS state.
  local mode=${1:-stale} key iface
  vpn_dns_state_keys | while IFS= read -r key; do
    [[ -n "$key" ]] || continue
    scutil_key_mentions_vpn_domain "$key" || continue
    iface=${key#State:/Network/Service/}
    iface=${iface%/DNS}
    if [[ "$mode" == all ]] || ! ifconfig "$iface" >/dev/null 2>&1; then
      log "Removing stale VPN DNS state: $key"
      remove_scutil_key "$key"
    fi
  done
}

cleanup_stale_gateway_route() {
  local gateway iface

  # route(8) reports a cloned host destination even when traffic merely follows
  # the normal default route. Only remove an exact entry present in the routing
  # table; otherwise every connect incorrectly deletes a healthy cached route.
  read -r gateway iface < <(netstat -rn -f inet 2>/dev/null \
    | awk -v target="$VPN_GATEWAY_IPV4" '$1 == target { print $2, $4; exit }') || true
  if [[ -n "${gateway:-}" && "${iface:-}" != utun* ]]; then
    log "Removing stale IPv4 host route for $VPN_GATEWAY_IPV4 via $gateway on $iface"
    route -n delete -host "$VPN_GATEWAY_IPV4" >/dev/null 2>&1 || true
  fi

  gateway=''
  iface=''
  read -r gateway iface < <(netstat -rn -f inet6 2>/dev/null \
    | awk -v target="$VPN_GATEWAY_IPV6" '$1 == target { print $2, $4; exit }') || true
  if [[ -n "${gateway:-}" && "${iface:-}" != utun* ]]; then
    log "Removing stale IPv6 host route for $VPN_GATEWAY_IPV6 via $gateway on $iface"
    route -n delete -inet6 -host "$VPN_GATEWAY_IPV6" >/dev/null 2>&1 || true
  fi
}

repair_dns() {
  # VPN DNS lives only in the utun Dynamic Store entry; never modify the user's
  # physical-interface DNS settings.
  clear_vpn_dns_state all
  killall -HUP mDNSResponder >/dev/null 2>&1 || true
}

cleanup_vpnc_state() {
  local pid=${1:-}
  [[ "$pid" =~ ^[0-9]+$ ]] || return 0
  # vpnc-script keys its default-route backups in /var/run/vpnc by pid. A
  # SIGKILL skips the disconnect hook, leaving them behind. Split mode never
  # writes them, but sweep defensively (recycled pid, prior session, or a server
  # that unexpectedly pushes a default route) so stale state cannot accumulate.
  rm -f "/var/run/vpnc/defaultroute.${pid}" \
        "/var/run/vpnc/defaultroute_ipv6.${pid}" \
        "/var/run/vpnc/resolv.conf-backup.${pid}" 2>/dev/null || true
}

cleanup_stale_state() {
  local pid
  pid=$(pid_from_file || true)
  if pid_is_openconnect "$pid"; then
    log "Stopping stale TU Wien OpenConnect process $pid"
    kill -KILL "$pid" 2>/dev/null || true
    sleep 1
  elif pid_is_alive "$pid"; then
    log "Refusing to signal unrelated process $pid referenced by stale PID file"
  fi
  # A SIGKILL skips vpnc-script's disconnect hook, orphaning its /var/run/vpnc
  # state. Sweep it so stale defaults can never survive a crash.
  cleanup_vpnc_state "$pid"
  rm -f "$PIDFILE"
  cleanup_stale_gateway_route
  clear_vpn_dns_state all
}

status() {
  local pid iface
  pid=$(pid_from_file || true)
  if ! pid_is_openconnect "$pid"; then
    echo down
    return 1
  fi

  iface=$(find_vpn_iface || true)
  if [[ ! "$iface" =~ ^utun[0-9]+$ ]]; then
    echo degraded
    return 2
  fi

  if vpn_healthcheck; then
    echo up
    return 0
  fi

  echo degraded
  return 2
}

prepare_log_file() {
  # Truncate at the start of each connect so `logs` reflects the current
  # session. OpenConnect's stderr contains no credentials (the password is
  # fed via stdin and the TOTP seed via /dev/fd/3), so it is safe to persist.
  mkdir -p "$LOG_DIR" 2>/dev/null || true
  chmod 755 "$LOG_DIR" 2>/dev/null || true
  : > "$LOG_FILE" 2>/dev/null || true
  chmod 600 "$LOG_FILE" 2>/dev/null || true
}

connect_summary() {
  local pid address expires
  pid=$(pid_from_file || true)
  address=$(grep -m1 'Configured as ' "$LOG_FILE" 2>/dev/null \
    | sed 's/^Configured as //; s/, with.*//' || true)
  expires=$(grep -m1 'Session authentication will expire at ' "$LOG_FILE" 2>/dev/null \
    | sed 's/^Session authentication will expire at //' || true)
  printf 'TUvpn: connected\n'
  [[ -n "$address" ]] && printf '  address: %s\n' "$address"
  [[ -n "$expires" ]] && printf '  session expires: %s\n' "$expires"
  [[ -n "$pid" ]] && printf '  pid: %s\n' "$pid"
}

print_recent_log() {
  local n=${1:-30}
  [[ -r "$LOG_FILE" ]] || return 0
  echo '--- recent OpenConnect log ---' >&2
  tail -n "$n" "$LOG_FILE" >&2 2>/dev/null || true
}

logs_impl() {
  if [[ -r "$LOG_FILE" ]]; then
    tail -n 250 "$LOG_FILE"
  else
    echo 'No OpenConnect log available yet.' >&2
    return 1
  fi
}

external_trusted() {
  # The privileged controller executes these absolute paths as root. Refuse any
  # install that is not root-owned and not group/world-writable (a user could
  # otherwise swap them for arbitrary code running as root).
  local path mode
  for path in "$OPENCONNECT" "$VPNC_SCRIPT"; do
    if [[ ! -x "$path" ]]; then
      log "Missing or not executable: $path"
      return 1
    fi
    if [[ "$(stat -f '%u' "$path" 2>/dev/null || echo x)" != 0 ]]; then
      log "Not root-owned, refusing: $path"
      return 1
    fi
    mode=$(stat -f '%Lp' "$path" 2>/dev/null || echo 0)
    mode=${mode//[!0-7]/0}
    if (( (8#$mode & 022) != 0 )); then
      log "Group/world-writable, refusing: $path"
      return 1
    fi
  done
  return 0
}

verify_split_tunnel() {
  # The one property this tool promises: TU traffic via the tunnel, everything
  # else via the physical network. A couple of route-table reads, no framework.
  local iface_tu iface_public
  iface_tu=$(route -n get "$VPN_DNS_IP" 2>/dev/null | awk -F': ' '/interface:/{print $2; exit}')
  iface_public=$(route -n get 1.1.1.1 2>/dev/null | awk -F': ' '/interface:/{print $2; exit}')
  if [[ "$iface_tu" =~ ^utun[0-9]+$ ]] && [[ ! "$iface_public" =~ ^utun[0-9]+$ ]]; then
    return 0
  fi
  log "Split-tunnel invariant failed (TU via ${iface_tu:-none}, public via ${iface_public:-none}); disconnecting."
  return 1
}

read_credentials() {
  # Called once per connect so every openconnect_cmd call (including
  # the internal retry) has credentials. stdin: account, password, TOTP seed,
  # fed by the unprivileged tuvpn wrapper from the login Keychain. Kept in shell
  # variables only - never argv, environment, or files.
  IFS= read -r USER_EMAIL || true
  IFS= read -r TUW_PASS || true
  IFS= read -r TUW_SEED || true
  [[ -n "$USER_EMAIL" && -n "$TUW_PASS" && -n "$TUW_SEED" ]] \
    || { log 'Missing credentials on stdin (connect via tuvpn, not sudo tuwien-vpnctl).'; return 1; }
}

openconnect_cmd() {
  local seed token_secret rc
  [[ -n "$USER_EMAIL" && -n "$TUW_PASS" && -n "$TUW_SEED" ]] \
    || { log 'No credentials available (run via tuvpn connect).'; return 1; }
  external_trusted || return 1

  # OpenConnect accepts a token secret from a file. /dev/fd/3 keeps the TOTP
  # seed out of both the filesystem and the process argument list.
  seed=${TUW_SEED//[[:space:]]/}
  while [[ "$seed" == *= ]]; do seed=${seed%=}; done
  [[ "$seed" =~ ^[A-Za-z2-7]+$ ]] || { log "Invalid Base32 TOTP seed in Keychain."; return 1; }
  while (( ${#seed} % 8 != 0 )); do seed="${seed}="; done
  token_secret="base32:${seed}"
  exec 3<<<"$token_secret"

  # Capture all OpenConnect (and vpnc-script) output to the log file so
  # `tuvpn logs` has something to show and the terminal stays quiet.
  prepare_log_file
  if printf '%s\n' "$TUW_PASS" | P11_KIT_NO_USER_CONFIG=1 "$OPENCONNECT" \
    --background \
    --pid-file="$PIDFILE" \
    --reconnect-timeout="$RECONNECT_TIMEOUT" \
    --force-dpd="$DPD_INTERVAL" \
    --no-dtls \
    --passwd-on-stdin \
    --token-mode=totp \
    --token-secret=@/dev/fd/3 \
    --authgroup="$AUTHGROUP" \
    --useragent="AnyConnect OpenConnect" \
    --no-external-auth \
    --no-proxy \
    --csd-wrapper=/usr/bin/false \
    --cafile=/etc/ssl/cert.pem \
    --script="$VPNC_SCRIPT" \
    "$@" \
    --user "$USER_EMAIL" \
    "$HOST" \
    >>"$LOG_FILE" 2>&1
  then
    rc=0
  else
    rc=$?
  fi

  exec 3<&-
  unset seed token_secret
  return "$rc"
}

wait_for_status_up() {
  local elapsed=0 state
  while (( elapsed < CONNECT_TIMEOUT )); do
    state=$(status || true)
    [[ "$state" == up ]] && return 0
    sleep 1
    elapsed=$((elapsed + 1))
  done
  return 1
}

disconnect_impl() {
  local pid elapsed=0

  pid=$(pid_from_file || true)
  if pid_is_openconnect "$pid"; then
    kill -TERM "$pid" 2>/dev/null || true
    while pid_is_openconnect "$pid" && (( elapsed < DISCONNECT_TIMEOUT )); do
      sleep 1
      elapsed=$((elapsed + 1))
    done
    if pid_is_openconnect "$pid"; then
      log "OpenConnect pid $pid did not exit cleanly; forcing kill."
      kill -KILL "$pid" 2>/dev/null || true
      sleep 1
    fi
  elif pid_is_alive "$pid"; then
    log "Refusing to signal unrelated process $pid referenced by PID file."
  fi

  rm -f "$PIDFILE"
  cleanup_stale_gateway_route
  clear_vpn_dns_state all
  repair_dns >/dev/null 2>&1 || true
}

wait_for_pidfile() {
  local elapsed=0
  while [[ ! -r "$PIDFILE" ]] && (( elapsed < 10 )); do
    sleep 1
    elapsed=$((elapsed + 1))
  done
  [[ -r "$PIDFILE" ]]
}

connect_once() {
  local host_ip
  cleanup_stale_state

  if ! system_resolves_vpn_host; then
    log "System resolver cannot resolve $HOST; repairing DNS before connect."
    repair_dns >/dev/null 2>&1 || true
  fi

  host_ip=$(resolve_vpn_host_public_ipv4 || true)
  log "Connecting to $HOST..."
  if [[ -n "$host_ip" ]] && ! system_resolves_vpn_host; then
    log "System resolver still cannot resolve $HOST; connecting with --resolve $HOST:$host_ip."
    if ! openconnect_cmd --resolve "${HOST}:${host_ip}"; then
      print_recent_log
      return 1
    fi
  else
    if ! openconnect_cmd; then
      print_recent_log
      return 1
    fi
  fi

  if ! wait_for_pidfile; then
    log "OpenConnect did not write PID file within 10s"
    print_recent_log
    return 1
  fi

  if ! wait_for_status_up; then
    log 'VPN did not become healthy.'
    print_recent_log
    return 1
  fi
  connect_summary
}

server_reachable() {
  local host_ip
  host_ip=$(resolve_vpn_host_public_ipv4 || true)
  if system_resolves_vpn_host && nc -G 3 -z "$HOST" 443 >/dev/null 2>&1; then
    return 0
  fi
  [[ -n "$host_ip" ]] && nc -G 3 -z "$host_ip" 443 >/dev/null 2>&1
}

connect_impl() {
  if [[ "$(status || true)" == up ]]; then
    return 0
  fi

  if connect_once; then
    if ! verify_split_tunnel; then
      disconnect_impl >/dev/null 2>&1 || true
      return 1
    fi
    return 0
  fi

  log "Initial connect attempt did not become healthy; repairing DNS and retrying once."
  repair_dns >/dev/null 2>&1 || true
  cleanup_stale_state
  if connect_once; then
    if ! verify_split_tunnel; then
      disconnect_impl >/dev/null 2>&1 || true
      return 1
    fi
    return 0
  fi

  log "VPN did not become healthy within ${CONNECT_TIMEOUT}s."
  return 1
}

doctor() {
  local pid command runtime_owner runtime_mode script_owner script_mode
  runtime_owner=$(stat -f '%Su:%Sg' "$OPENCONNECT" 2>/dev/null || true)
  runtime_mode=$(stat -f '%OLp' "$OPENCONNECT" 2>/dev/null || true)
  script_owner=$(stat -f '%Su:%Sg' "$VPNC_SCRIPT" 2>/dev/null || true)
  script_mode=$(stat -f '%OLp' "$VPNC_SCRIPT" 2>/dev/null || true)

  echo "openconnect=$([[ -x "$OPENCONNECT" ]] && echo present || echo missing)"
  echo "openconnect_owner=${runtime_owner:-unknown}"
  echo "openconnect_mode=${runtime_mode:-unknown}"
  echo "vpnc_script=$([[ -x "$VPNC_SCRIPT" ]] && echo present || echo missing)"
  echo "vpnc_script_owner=${script_owner:-unknown}"
  echo "vpnc_script_mode=${script_mode:-unknown}"
  echo "external_trusted=$(if external_trusted >/dev/null 2>&1; then echo yes; else echo no; fi)"
  echo "server_reachable=$(server_reachable && echo yes || echo no)"
  echo "status=$(status || true)"

  pid=$(pid_from_file || true)
  if pid_is_openconnect "$pid"; then
    command=$(ps -p "$pid" -o command= 2>/dev/null || true)
    if [[ "$command" == *'--token-secret=base32:'* ]]; then
      echo 'token_argument=EXPOSED'
    else
      echo 'token_argument=safe'
    fi
  else
    echo 'token_argument=not-running'
  fi
}

main() {
  require_root
  case "${1:-}" in
    status) status ;;
    connect) read_credentials && with_lock connect_impl ;;
    disconnect) with_lock disconnect_impl ;;
    doctor) doctor ;;
    logs) logs_impl ;;
    *) usage; exit 2 ;;
  esac
}

main "$@"
